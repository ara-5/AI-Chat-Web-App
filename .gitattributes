# Normalize line endings in the repository to LF
* text=auto eol=lf

# Shell scripts must use LF (will fail with CRLF on Linux)
*.sh text eol=lf
mvnw text eol=lf

# Windows batch files keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — do not convert
*.jar binary
*.png binary
*.jpg binary
*.gif binary
